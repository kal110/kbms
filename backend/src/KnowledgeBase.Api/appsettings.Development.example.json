{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "Kbms": "Host=localhost;Port=5432;Database=kbms;Username=postgres;Password=<your-postgres-password>;"
  },
  "Auth": {
    "DevIssuer": "kbms-dev",
    "DevSigningKey": "dev-only-signing-key-change-me-0123456789abcdef",
    "DevTokenHours": 8
  },
  "Cors": {
    "Origins": [ "http://localhost:5173","http://localhost:5174" ]
  },
  "Storage": {
    "Provider": "S3",
    "PublicBaseUrl": "http://localhost:5259",
    "SigningKey": "dev-only-storage-key-change-me-0123456789abcdef",
    "S3": {
      "ServiceUrl": "http://localhost:25490",
      "PublicUrl": "http://localhost:25490",
      "Region": "us-east-1",
      "Bucket": "kbms-local",
      "AccessKey": "kbms",
      "SecretKey": "kbms-dev-secret",
      "ForcePathStyle": true,
      "CreateBucket": true
    }
  },
  "Ai": {
    "Enabled": true,
    "Embedding": { "Endpoint": "http://localhost:25434/v1" },
    "Chat": { "Local": { "Endpoint": "http://localhost:25434/v1" } },
    "VectorStore": { "Url": "http://localhost:25463" }
  },
  "Database": {
    "MigrateOnStartup": true,
    "Seed": true
  }
}

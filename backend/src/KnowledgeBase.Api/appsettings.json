{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
   "ConnectionStrings": {
    "Kbms": "Host=localhost;Port=5432;Database=kbms;Username=postgres;"
  },
  "Auth": {
    "Authority": "",
    "Audience": "kbms-api"
  },
  "Cors": {
    "Origins": []
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "storage",
    "PublicBaseUrl": "",
    "SigningKey": ""
  },
  "Ai": {
    "Enabled": false,
    "IndexSyncSeconds": 30,
    "Embedding": {
      "Endpoint": "http://localhost:11434/v1",
      "ApiKey": "",
      "Model": "bge-m3",
      "Dimensions": 1024,
      "BatchSize": 64,
      "TimeoutSeconds": 120
    },
    "VectorStore": {
      "Url": "http://localhost:6333",
      "ApiKey": "",
      "CollectionAlias": "kb_chunks"
    },
    "Chunking": {
      "TargetTokens": 500,
      "MaxTokens": 800,
      "OverlapTokens": 80,
      "MinTokens": 120,
      "LowTextChars": 40
    },
    "Retrieval": {
      "Candidates": 40,
      "Passages": 8,
      "MaxPassagesPerDocument": 3,
      "MinScore": 0.45,
      "MinPassageScore": 0.40,
      "MaxQuestionChars": 2000,
      "RequestsPerMinute": 20
    },
    "Chat": {
      "Provider": "Local",
      "Local": {
        "Endpoint": "http://localhost:11434/v1",
        "ApiKey": "",
        "Model": "qwen3.5:4b",
        "MaxTokens": 1500,
        "Temperature": 0.2,
        "ReasoningEffort": "none",
        "TimeoutSeconds": 300
      },
      "Anthropic": {
        "Model": "claude-opus-5-5",
        "ApiKey": "",
        "MaxTokens": 16000,
        "Effort": "medium"
      }
    },
    "Audit": {
      "KeepText": false
    }
  },
  "Processing": {
    "WorkersEnabled": true,
    "PollSeconds": 5,
    "MaxAttempts": 5,
    "PipelineVersion": 1
  },
  "Database": {
    "MigrateOnStartup": false,
    "Seed": false,
    "Admin": {
      "ExternalId": "admin",
      "DisplayName": "System Administrator",
      "Email": "admin@usa.edu.ph"
    }
  }
}

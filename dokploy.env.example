# KBMS on Dokploy, opened by the server's LAN address (no domain). Paste into the Docker Compose
# service's Environment tab; Dokploy writes it to the .env next to compose.yaml, which fills every
# ${KBMS_*} there. Replace each CHANGE_ME (long random values, e.g. `openssl rand -hex 32`) and
# 192.168.1.50 (the server's address) first.
#
# Dokploy settings:
#   General      Provider: this repository, branch main. Compose path: ./compose.yaml (add
#                compose.gpu.yaml only on a server with an NVIDIA GPU and the NVIDIA container toolkit).
#   Advanced     Isolated Deployments on, so the stack keeps its own network.
#   Domains      None. Browsers reach the published ports below directly (http://192.168.1.50:25480),
#                not through Dokploy's Traefik.
#   The server   A fixed LAN address (static, or a DHCP reservation): the links KBMS signs carry it. Its
#                firewall allows TCP 25480 (the site) and 25490 (S3: browsers upload and download there).
#
# Each deploy clones from GitHub and builds the images, and the first one downloads the AI models
# (about 4.5 GB) after the stack is up, so the server itself needs internet for those.

# ---- Sign-in -------------------------------------------------------------------------------------
# There is no university IdP yet, so the server runs the demo sign-in (Development). Anyone on the
# network who can open the site can sign in as any account, the System Administrator included. Limit who
# reaches ports 25480 and 25490 (firewall allow-list, VLAN, VPN) until KBMS_AUTH_AUTHORITY is set and
# KBMS_ENVIRONMENT is Production.
KBMS_ENVIRONMENT=Development
KBMS_SEED=true
KBMS_DEV_SIGNING_KEY=CHANGE_ME
KBMS_AUTH_AUTHORITY=
KBMS_AUTH_AUDIENCE=kbms-api

# ---- Addresses browsers use -------------------------------------------------------------------------
# Plain http on the server's LAN address and the ports below, exactly as people type it: S3 accepts
# uploads only from pages at KBMS_WEB_URL, and upload and download links are signed for
# KBMS_S3_PUBLIC_URL. If the server's address changes, change both and redeploy.
KBMS_WEB_URL=http://192.168.1.50:25480
KBMS_S3_PUBLIC_URL=http://192.168.1.50:25490
# With domains later instead: Domains web:80 → https://kbms.example.com and s3:9000 →
# https://s3.kbms.example.com, both with HTTPS; set the two URLs to those and KBMS_BIND_ADDRESS=127.0.0.1.

# ---- Host ports -----------------------------------------------------------------------------------
# The site and S3 on every interface, so the LAN reaches them. PostgreSQL and the RustFS console only on
# the server itself; reach PostgreSQL through an SSH tunnel (ssh -L 25432:127.0.0.1:25432). Qdrant and
# Ollama are always loopback-only.
KBMS_BIND_ADDRESS=0.0.0.0
KBMS_ADMIN_BIND_ADDRESS=127.0.0.1
KBMS_WEB_PORT=25480
KBMS_DB_PORT=25432
KBMS_S3_PORT=25490
KBMS_S3_CONSOLE_PORT=25491
KBMS_QDRANT_PORT=25463
KBMS_OLLAMA_PORT=25434

# ---- Database and object storage --------------------------------------------------------------------
# Set before the first deploy: PostgreSQL keeps its first password in its volume, so changing it later
# also needs an ALTER USER inside the database.
KBMS_DB_USER=kbms
KBMS_DB_PASSWORD=CHANGE_ME
KBMS_S3_ACCESS_KEY=kbms
KBMS_S3_SECRET_KEY=CHANGE_ME

# ---- AI ---------------------------------------------------------------------------------------------
KBMS_AI_ENABLED=true
KBMS_EMBEDDING_MODEL=bge-m3
KBMS_EMBEDDING_DIMENSIONS=1024
KBMS_COLLECTION_ALIAS=kb_docker
# Local runs the answer model in Ollama on the server. Without a GPU, an answer from qwen3.5:4b can take
# a minute or more: use qwen3.5:2b, or Anthropic with an API key.
KBMS_CHAT_PROVIDER=Local
KBMS_CHAT_MODEL=qwen3.5:4b
KBMS_OLLAMA_CONTEXT_LENGTH=16384
ANTHROPIC_API_KEY=

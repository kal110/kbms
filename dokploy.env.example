# KBMS on Dokploy. Paste into the Docker Compose service's Environment tab; Dokploy writes it to the
# .env next to compose.yaml, which fills every ${KBMS_*} there. Replace each CHANGE_ME (long random
# values, e.g. `openssl rand -hex 32`) and the example domains first.
#
# Dokploy settings:
#   General      Provider: this repository, branch main. Compose path: ./compose.yaml (add
#                compose.gpu.yaml only on a server with an NVIDIA GPU and the NVIDIA container toolkit).
#   Advanced     Isolated Deployments on, so the services still reach each other once a domain is added.
#   Domains      web, container port 80  → KBMS_WEB_URL, with HTTPS.
#                s3,  container port 9000 → KBMS_S3_PUBLIC_URL, with HTTPS (browsers upload and download there).
#                Nothing else gets a domain: the API is reached through web's /api, and db, qdrant and
#                ollama stay inside.
#
# The first deploy downloads the AI models (about 4.5 GB) after the stack is up.

# ---- Sign-in -------------------------------------------------------------------------------------
# There is no university IdP yet, so the server runs the demo sign-in (Development). Anyone who can
# open the site can sign in as any account, the System Administrator included. Keep the site private
# (VPN, firewall allow-list, or basic auth on the domain) until KBMS_AUTH_AUTHORITY is set and
# KBMS_ENVIRONMENT is Production.
KBMS_ENVIRONMENT=Development
KBMS_SEED=true
KBMS_DEV_SIGNING_KEY=CHANGE_ME
KBMS_AUTH_AUTHORITY=
KBMS_AUTH_AUDIENCE=kbms-api

# ---- Public addresses (the two domains above) -----------------------------------------------------
KBMS_WEB_URL=https://kbms.example.com
KBMS_S3_PUBLIC_URL=https://s3.kbms.example.com

# ---- Host ports -----------------------------------------------------------------------------------
# Loopback only: Traefik reaches web and s3 over Docker's network, and the database and S3 stay off the
# internet. Use an SSH tunnel to reach them (e.g. ssh -L 25432:127.0.0.1:25432 for PostgreSQL).
KBMS_BIND_ADDRESS=127.0.0.1
KBMS_WEB_PORT=25480
KBMS_DB_PORT=25432
KBMS_S3_PORT=25490
KBMS_S3_CONSOLE_PORT=25491
KBMS_QDRANT_PORT=25463
KBMS_OLLAMA_PORT=25434

# ---- Database and object storage --------------------------------------------------------------------
# Set before the first deploy: PostgreSQL keeps its first password in its volume, so changing it later
# also needs an ALTER USER inside the database.
KBMS_DB_USER=kbms
KBMS_DB_PASSWORD=CHANGE_ME
KBMS_S3_ACCESS_KEY=kbms
KBMS_S3_SECRET_KEY=CHANGE_ME

# ---- AI ---------------------------------------------------------------------------------------------
KBMS_AI_ENABLED=true
KBMS_EMBEDDING_MODEL=bge-m3
KBMS_EMBEDDING_DIMENSIONS=1024
KBMS_COLLECTION_ALIAS=kb_docker
# Local runs the answer model in Ollama on the server. Without a GPU, an answer from qwen3.5:4b can take
# a minute or more: use qwen3.5:2b, or Anthropic with an API key.
KBMS_CHAT_PROVIDER=Local
KBMS_CHAT_MODEL=qwen3.5:4b
KBMS_OLLAMA_CONTEXT_LENGTH=16384
ANTHROPIC_API_KEY=

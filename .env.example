ok# Copy to .env (next to compose.yaml) to override the defaults. The defaults are for a local demo;
# change every password and key before the stack is reachable by anyone else.

# Development = dev sign-in, migrations and the seed (System Administrator + default settings). Production needs KBMS_AUTH_AUTHORITY.
KBMS_ENVIRONMENT=Development
KBMS_SEED=true
# With no Authority, the dev sign-in (POST /api/dev/token) signs its tokens with this key (32+ characters).
KBMS_DEV_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef
# The university IdP (OIDC issuer URL) for Production, and the audience its tokens carry.
KBMS_AUTH_AUTHORITY=
KBMS_AUTH_AUDIENCE=kbms-api

KBMS_DB_USER=kbms
KBMS_DB_PASSWORD=kbms-dev-password
KBMS_DB_PORT=25432

KBMS_S3_ACCESS_KEY=kbms
KBMS_S3_SECRET_KEY=kbms-dev-secret
KBMS_S3_PORT=25490
KBMS_S3_CONSOLE_PORT=25491

KBMS_WEB_PORT=25480

# The host address the ports above listen on: 0.0.0.0 = every interface, 127.0.0.1 = this machine only.
KBMS_BIND_ADDRESS=0.0.0.0
# PostgreSQL and the RustFS console, which only admins use. Empty = KBMS_BIND_ADDRESS; 127.0.0.1 keeps
# them on this machine while the web app and S3 are on the LAN.
KBMS_ADMIN_BIND_ADDRESS=
# The addresses browsers use. Upload and download links are signed for KBMS_S3_PUBLIC_URL, and S3
# accepts uploads from pages at KBMS_WEB_URL. Empty = http://localhost with the ports above; for other
# PCs on the LAN, this machine's address, e.g. http://192.168.1.50:25480 and http://192.168.1.50:25490.
KBMS_WEB_URL=
KBMS_S3_PUBLIC_URL=

# AI search and the assistant. Embeddings run locally (Ollama); a different model needs its dimensions
# too, and changing either makes the index worker rebuild the vector index.
KBMS_AI_ENABLED=true
KBMS_EMBEDDING_MODEL=bge-m3
KBMS_EMBEDDING_DIMENSIONS=1024
KBMS_QDRANT_PORT=25463
KBMS_OLLAMA_PORT=25434
# The Docker API's collection names (kb_docker_v1, …), kept apart from an API on the host (kb_chunks).
KBMS_COLLECTION_ALIAS=kb_docker

# Who answers the assistant's questions: Local (a small model in Ollama, nothing leaves this machine)
# or Anthropic (Claude, needs ANTHROPIC_API_KEY). A local model must fit the GPU's memory next to
# bge-m3: qwen3.5:4b for about 6 GB, qwen3.5:2b for less, qwen3.5:9b with 12 GB or more.
KBMS_CHAT_PROVIDER=Local
KBMS_CHAT_MODEL=qwen3.5:4b
# Ollama's context window in tokens; it must hold the passages and the answer.
KBMS_OLLAMA_CONTEXT_LENGTH=16384
ANTHROPIC_API_KEY=

# NVIDIA GPU: uncomment so every `docker compose` command also loads compose.gpu.yaml.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=compose.yaml,compose.gpu.yaml
